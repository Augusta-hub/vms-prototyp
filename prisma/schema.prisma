// Datenmodell zu SPEC Kapitel 3.1 bis 3.7 und 3.11.
//
// Umfang: Mandant, Benutzer, Rollenzuweisung, Zuständigkeit,
// Betreuungszuordnung und Vertretung (3.11) sowie Kunde, Standort,
// Kostenstelle (3.1), Lieferant und AÜG-Erlaubnis (3.2), Rahmenvertrag,
// Preisliste, Tarifzuordnung, Vergleichsentgelt (3.3), Bedarfsanfrage (3.4),
// Ausschreibung, Einladung, Lieferantenangebot (3.5), Kandidat,
// Profilvorschlag und Personenidentität (3.6) sowie Einsatz, Verlängerung und
// Unterbrechung (3.7).
//
// Noch nicht modelliert: Zeiten (3.8), Abrechnung (3.9), Dokument / Nachweis
// (3.10) und der Audit-Eintrag (3.12). Verweise dorthin sind als benannte
// Skalare geführt und im jeweiligen Modell kommentiert — nicht
// stillschweigend weggelassen.
//
// Jedes Modell trägt die Standardfelder aus SPEC 3.0:
//   id, tenantId (bei mandantengebundenen Objekten), createdAt/createdById,
//   updatedAt/updatedById, deactivatedAt/deactivatedById, externalReference.
// Das Standardfeld `status` fehlt überall, weil 3.0 es nur verlangt, "wo ein
// Statusmodell existiert" — und 3.11 nennt für jedes Objekt dieses Kapitels
// ausdrücklich "Statusmodell: keines". Aktiv/inaktiv läuft über
// `deactivatedAt`, die Wirksamkeit einer Vertretung über ihren Zeitraum.
//
// Die Rechte einer Rolle sind KEINE Daten (3.11): sie stehen als Code in
// lib/authz/matrix.ts. Deshalb gibt es keine Tabelle für Rolle, Operation
// oder Berechtigung — nur das Enum der acht Rollenkürzel aus 2.1.
//
// Anmelde- und Zahlungsdaten sind nicht Teil des Modells (3.0, Festlegung 4
// und 5). `loginIdentifier` ist die Kennung der Person, kein Geheimnis.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Mandantentyp (3.11): genau ein Mandant trägt `operator`.
enum TenantType {
  operator
  customer
  supplier
}

/// Die acht Rollenkürzel aus SPEC 2.1 als fester Katalog (3.11).
/// `temporaryWorker` existiert nur, wenn offene Frage 4 mit "eigener Zugang"
/// beantwortet wird; andernfalls entfällt der Wert ersatzlos.
enum RoleCode {
  operatorAdmin
  operatorCoordinator
  demandOwner
  approver
  procurementController
  supplierCoordinator
  supplierAdmin
  temporaryWorker
}

/// Art einer Zuständigkeit (3.11): Standort oder Kostenstelle.
enum ScopeType {
  site
  costCenter
}

/// Mandant (`tenant`, SPEC 3.11) — der Datenraum einer Organisation.
///
/// `organizationId` verweist fachlich auf `customer` (3.1) bzw. `supplier`
/// (3.2); welche der beiden gemeint ist, sagt `tenantType`. Der Verweis ist
/// polymorph und bleibt deshalb ein Skalar ohne Fremdschlüssel; die
/// Gegenrichtung ist typisiert (`Customer.tenantId` / `Supplier.tenantId`,
/// beide eindeutig) und trägt die Kardinalität 1 : 0..1 aus 3.11.
///
/// Invariante aus 3.11: höchstens ein Mandant mit `tenantType = operator`.
/// PostgreSQL kennt dafür nur einen partiellen Index, den Prisma im Schema
/// nicht ausdrücken kann; die Invariante wird in lib/tenants/invariants.ts
/// geprüft und vom Seed eingehalten.
model Tenant {
  id                String     @id @default(cuid())
  tenantNumber      String     @unique
  tenantType        TenantType
  organizationId    String?
  displayName       String
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("TenantCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("TenantUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("TenantDeactivatedBy", fields: [deactivatedById], references: [id])

  users                User[]                @relation("TenantUsers")
  roleAssignments      RoleAssignment[]
  responsibilityScopes ResponsibilityScope[]
  delegations          Delegation[]
  accountAssignments   AccountAssignment[]   @relation("AccountAssignmentCustomerTenant")

  // Fachmodule 3.1 bis 3.5. Der Mandant trägt die Mandantengrenze aus 2.3;
  // jedes mandantengebundene Objekt hängt deshalb an genau einem Mandanten.
  customer                       Customer?                       @relation("CustomerTenant")
  supplier                       Supplier?                       @relation("SupplierTenant")
  sites                          Site[]
  costCenters                    CostCenter[]
  supplierPermits                SupplierPermit[]
  masterAgreements               MasterAgreement[]
  rateCards                      RateCard[]
  collectiveAgreementAssignments CollectiveAgreementAssignment[]
  comparableWageEntries          ComparableWageEntry[]
  demandRequests                 DemandRequest[]
  tenders                        Tender[]
  tenderInvitations              TenderInvitation[]
  supplierOffers                 SupplierOffer[]

  // Fachmodule 3.6 und 3.7. Die Personenidentität hängt **ausschließlich** am
  // Betreibermandanten ([43], 3.6), der Einsatz ebenfalls (3.7); Kandidat und
  // Profilvorschlag am Lieferantenmandanten.
  candidates           Candidate[]
  candidateSubmissions CandidateSubmission[]
  workerIdentities     WorkerIdentity[]
  assignments          Assignment[]

  @@index([tenantType])
}

/// Benutzer (`user`, SPEC 3.11) — eine Person mit Zugang zum System.
///
/// `tenantId` ist die Mandantenzuordnung: genau ein Mandant je Benutzer
/// (3.11). Mehrfachrollen gibt es nur innerhalb dieser einen Organisation
/// (Kapitel 2).
model User {
  id                String  @id @default(cuid())
  userNumber        String
  tenantId          String
  tenant            Tenant  @relation("TenantUsers", fields: [tenantId], references: [id])
  loginIdentifier   String  @unique
  givenName         String
  familyName        String
  language          String?
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("UserDeactivatedBy", fields: [deactivatedById], references: [id])

  roleAssignments       RoleAssignment[]    @relation("RoleAssignmentUser")
  grantedAssignments    RoleAssignment[]    @relation("RoleAssignmentGrantedBy")
  accountAssignments    AccountAssignment[] @relation("AccountAssignmentUser")
  delegationsAsDelegate Delegation[]        @relation("DelegationDelegateUser")

  // Rückbeziehungen der Protokollfelder aus 3.0. Prisma verlangt sie für jede
  // Relation; fachlich werden sie nicht gelesen — das fachliche Protokoll ist
  // der Audit-Eintrag aus 3.12.
  createdTenants                Tenant[]              @relation("TenantCreatedBy")
  updatedTenants                Tenant[]              @relation("TenantUpdatedBy")
  deactivatedTenants            Tenant[]              @relation("TenantDeactivatedBy")
  createdUsers                  User[]                @relation("UserCreatedBy")
  updatedUsers                  User[]                @relation("UserUpdatedBy")
  deactivatedUsers              User[]                @relation("UserDeactivatedBy")
  createdRoleAssignments        RoleAssignment[]      @relation("RoleAssignmentCreatedBy")
  updatedRoleAssignments        RoleAssignment[]      @relation("RoleAssignmentUpdatedBy")
  deactivatedRoleAssignments    RoleAssignment[]      @relation("RoleAssignmentDeactivatedBy")
  createdScopes                 ResponsibilityScope[] @relation("ScopeCreatedBy")
  updatedScopes                 ResponsibilityScope[] @relation("ScopeUpdatedBy")
  deactivatedScopes             ResponsibilityScope[] @relation("ScopeDeactivatedBy")
  createdAccountAssignments     AccountAssignment[]   @relation("AccountAssignmentCreatedBy")
  updatedAccountAssignments     AccountAssignment[]   @relation("AccountAssignmentUpdatedBy")
  deactivatedAccountAssignments AccountAssignment[]   @relation("AccountAssignmentDeactivatedBy")
  createdDelegations            Delegation[]          @relation("DelegationCreatedBy")
  updatedDelegations            Delegation[]          @relation("DelegationUpdatedBy")
  deactivatedDelegations        Delegation[]          @relation("DelegationDeactivatedBy")
  revokedDelegations            Delegation[]          @relation("DelegationRevokedBy")

  // Protokollfelder der Fachmodule 3.1 bis 3.5, derselbe Pflichtumfang.
  createdCustomers                Customer[]                      @relation("CustomerCreatedBy")
  updatedCustomers                Customer[]                      @relation("CustomerUpdatedBy")
  deactivatedCustomers            Customer[]                      @relation("CustomerDeactivatedBy")
  createdContacts                 ContactPerson[]                 @relation("ContactCreatedBy")
  updatedContacts                 ContactPerson[]                 @relation("ContactUpdatedBy")
  deactivatedContacts             ContactPerson[]                 @relation("ContactDeactivatedBy")
  createdSites                    Site[]                          @relation("SiteCreatedBy")
  updatedSites                    Site[]                          @relation("SiteUpdatedBy")
  deactivatedSites                Site[]                          @relation("SiteDeactivatedBy")
  createdCostCenters              CostCenter[]                    @relation("CostCenterCreatedBy")
  updatedCostCenters              CostCenter[]                    @relation("CostCenterUpdatedBy")
  deactivatedCostCenters          CostCenter[]                    @relation("CostCenterDeactivatedBy")
  responsibleForCostCenters       CostCenter[]                    @relation("CostCenterResponsibleUser")
  createdSuppliers                Supplier[]                      @relation("SupplierCreatedBy")
  updatedSuppliers                Supplier[]                      @relation("SupplierUpdatedBy")
  deactivatedSuppliers            Supplier[]                      @relation("SupplierDeactivatedBy")
  blockedSuppliers                Supplier[]                      @relation("SupplierBlockedBy")
  createdPermits                  SupplierPermit[]                @relation("PermitCreatedBy")
  updatedPermits                  SupplierPermit[]                @relation("PermitUpdatedBy")
  deactivatedPermits              SupplierPermit[]                @relation("PermitDeactivatedBy")
  verifiedPermits                 SupplierPermit[]                @relation("PermitVerifiedBy")
  createdAgreements               MasterAgreement[]               @relation("AgreementCreatedBy")
  updatedAgreements               MasterAgreement[]               @relation("AgreementUpdatedBy")
  deactivatedAgreements           MasterAgreement[]               @relation("AgreementDeactivatedBy")
  createdRateCards                RateCard[]                      @relation("RateCardCreatedBy")
  updatedRateCards                RateCard[]                      @relation("RateCardUpdatedBy")
  deactivatedRateCards            RateCard[]                      @relation("RateCardDeactivatedBy")
  createdRateCardItems            RateCardItem[]                  @relation("RateCardItemCreatedBy")
  updatedRateCardItems            RateCardItem[]                  @relation("RateCardItemUpdatedBy")
  deactivatedRateCardItems        RateCardItem[]                  @relation("RateCardItemDeactivatedBy")
  createdCollectiveAgreements     CollectiveAgreementAssignment[] @relation("CaaCreatedBy")
  updatedCollectiveAgreements     CollectiveAgreementAssignment[] @relation("CaaUpdatedBy")
  deactivatedCollectiveAgreements CollectiveAgreementAssignment[] @relation("CaaDeactivatedBy")
  createdWageEntries              ComparableWageEntry[]           @relation("WageCreatedBy")
  updatedWageEntries              ComparableWageEntry[]           @relation("WageUpdatedBy")
  deactivatedWageEntries          ComparableWageEntry[]           @relation("WageDeactivatedBy")
  reportedWageEntries             ComparableWageEntry[]           @relation("WageReportedBy")
  createdDemandRequests           DemandRequest[]                 @relation("DemandCreatedBy")
  updatedDemandRequests           DemandRequest[]                 @relation("DemandUpdatedBy")
  deactivatedDemandRequests       DemandRequest[]                 @relation("DemandDeactivatedBy")
  requestedDemandRequests         DemandRequest[]                 @relation("DemandRequestedBy")
  onBehalfDemandRequests          DemandRequest[]                 @relation("DemandOnBehalfOf")
  approvedDemandRequests          DemandRequest[]                 @relation("DemandApprovedBy")
  createdQualifications           DemandRequestQualification[]    @relation("QualificationCreatedBy")
  updatedQualifications           DemandRequestQualification[]    @relation("QualificationUpdatedBy")
  deactivatedQualifications       DemandRequestQualification[]    @relation("QualificationDeactivatedBy")
  createdTenders                  Tender[]                        @relation("TenderCreatedBy")
  updatedTenders                  Tender[]                        @relation("TenderUpdatedBy")
  deactivatedTenders              Tender[]                        @relation("TenderDeactivatedBy")
  publishedTenders                Tender[]                        @relation("TenderPublishedBy")
  createdInvitations              TenderInvitation[]              @relation("InvitationCreatedBy")
  updatedInvitations              TenderInvitation[]              @relation("InvitationUpdatedBy")
  deactivatedInvitations          TenderInvitation[]              @relation("InvitationDeactivatedBy")
  createdOffers                   SupplierOffer[]                 @relation("OfferCreatedBy")
  updatedOffers                   SupplierOffer[]                 @relation("OfferUpdatedBy")
  deactivatedOffers               SupplierOffer[]                 @relation("OfferDeactivatedBy")
  createdOfferItems               SupplierOfferItem[]             @relation("OfferItemCreatedBy")
  updatedOfferItems               SupplierOfferItem[]             @relation("OfferItemUpdatedBy")
  deactivatedOfferItems           SupplierOfferItem[]             @relation("OfferItemDeactivatedBy")

  // Protokoll- und Fachfelder der Module 3.6 und 3.7.
  createdCandidates               Candidate[]                @relation("CandidateCreatedBy")
  updatedCandidates               Candidate[]                @relation("CandidateUpdatedBy")
  deactivatedCandidates           Candidate[]                @relation("CandidateDeactivatedBy")
  createdCandidateQualifications  CandidateQualification[]   @relation("CandidateQualificationCreatedBy")
  updatedCandidateQualifications  CandidateQualification[]   @relation("CandidateQualificationUpdatedBy")
  deactivatedCandidateQuals       CandidateQualification[]   @relation("CandidateQualificationDeactivatedBy")
  createdSubmissions              CandidateSubmission[]      @relation("SubmissionCreatedBy")
  updatedSubmissions              CandidateSubmission[]      @relation("SubmissionUpdatedBy")
  deactivatedSubmissions          CandidateSubmission[]      @relation("SubmissionDeactivatedBy")
  decidedSubmissions              CandidateSubmission[]      @relation("SubmissionDecidedBy")
  createdIdentities               WorkerIdentity[]           @relation("IdentityCreatedBy")
  updatedIdentities               WorkerIdentity[]           @relation("IdentityUpdatedBy")
  deactivatedIdentities           WorkerIdentity[]           @relation("IdentityDeactivatedBy")
  confirmedIdentities             WorkerIdentity[]           @relation("IdentityConfirmedBy")
  createdIdentityLinks            WorkerIdentityLink[]       @relation("LinkCreatedBy")
  updatedIdentityLinks            WorkerIdentityLink[]       @relation("LinkUpdatedBy")
  deactivatedIdentityLinks        WorkerIdentityLink[]       @relation("LinkDeactivatedBy")
  confirmedIdentityLinks          WorkerIdentityLink[]       @relation("LinkConfirmedBy")
  detachedIdentityLinks           WorkerIdentityLink[]       @relation("LinkDetachedBy")
  createdMergeEntries             WorkerIdentityMergeEntry[] @relation("MergeEntryCreatedBy")
  updatedMergeEntries             WorkerIdentityMergeEntry[] @relation("MergeEntryUpdatedBy")
  actedMergeEntries               WorkerIdentityMergeEntry[] @relation("MergeEntryActedBy")
  createdAssignments              Assignment[]               @relation("AssignmentCreatedBy")
  updatedAssignments              Assignment[]               @relation("AssignmentUpdatedBy")
  deactivatedAssignments          Assignment[]               @relation("AssignmentDeactivatedBy")
  terminationRequestedAssignments Assignment[]               @relation("AssignmentTerminationRequestedBy")
  terminationApprovedAssignments  Assignment[]               @relation("AssignmentTerminationApprovedBy")
  createdExtensions               AssignmentExtension[]      @relation("ExtensionCreatedBy")
  updatedExtensions               AssignmentExtension[]      @relation("ExtensionUpdatedBy")
  deactivatedExtensions           AssignmentExtension[]      @relation("ExtensionDeactivatedBy")
  requestedExtensions             AssignmentExtension[]      @relation("ExtensionRequestedBy")
  approvedExtensions              AssignmentExtension[]      @relation("ExtensionApprovedBy")
  effectiveExtensions             AssignmentExtension[]      @relation("ExtensionEffectiveBy")
  createdInterruptions            AssignmentInterruption[]   @relation("InterruptionCreatedBy")
  updatedInterruptions            AssignmentInterruption[]   @relation("InterruptionUpdatedBy")
  deactivatedInterruptions        AssignmentInterruption[]   @relation("InterruptionDeactivatedBy")

  // Fachliche Kennungen sind je Mandant eindeutig (3.0).
  @@unique([tenantId, userNumber])
  @@index([tenantId])
}

/// Rollenzuweisung (`roleAssignment`, SPEC 3.11) — die Einheit, auf die sich
/// Vertretung und Audit-Eintrag beziehen, nicht der Benutzer.
///
/// `tenantId` muss dem Mandanten des Benutzers entsprechen (3.11); das prüft
/// lib/authz/grants.ts, weil Prisma die Gleichheit zweier Fremdschlüssel nicht
/// erzwingen kann.
model RoleAssignment {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation("RoleAssignmentUser", fields: [userId], references: [id])
  roleCode          RoleCode
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  validFrom         DateTime
  validTo           DateTime?
  grantedById       String
  grantedBy         User      @relation("RoleAssignmentGrantedBy", fields: [grantedById], references: [id])
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("RoleAssignmentCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("RoleAssignmentUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("RoleAssignmentDeactivatedBy", fields: [deactivatedById], references: [id])

  responsibilityScopes ResponsibilityScope[]
  delegations          Delegation[]

  @@index([userId])
  @@index([tenantId])
}

/// Zuständigkeit (`responsibilityScope`, SPEC 3.11) — Einschränkung innerhalb
/// eines Mandanten. Fehlt zu einer Rollenzuweisung jede Zuständigkeit, wirkt
/// sie auf den ganzen Mandanten.
///
/// Ob die Einschränkung überhaupt eingeführt wird, ist offene Frage 14; wird
/// sie verworfen, entfällt dieses Modell ersatzlos.
///
/// `scopeRef` verweist fachlich auf `site` bzw. `costCenter` (3.1). Beide
/// Objekte sind noch nicht modelliert — bis dahin ein Skalar ohne
/// Fremdschlüssel.
model ResponsibilityScope {
  id                String         @id @default(cuid())
  roleAssignmentId  String
  roleAssignment    RoleAssignment @relation(fields: [roleAssignmentId], references: [id])
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  scopeType         ScopeType
  scopeRef          String
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("ScopeCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("ScopeUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("ScopeDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([roleAssignmentId])
  @@index([tenantId])
}

/// Betreuungszuordnung (`accountAssignment`, SPEC 3.11) — schränkt die
/// Querschnittssicht eines MSP-Benutzers auf eine Teilmenge der Kunden ein
/// (2.3). Fehlt sie für einen MSP-Benutzer vollständig, ist das eine bewusste
/// Entscheidung des `MA` und Gegenstand des Berechtigungsreviews.
///
/// `customerTenantId` verweist auf den Mandanten des Kunden. 3.11 nennt hier
/// einen Verweis auf `customer` (3.1); solange dieses Objekt nicht modelliert
/// ist, trägt der Kundenmandant die Zuordnung — er steht 1:1 zum Kunden.
model AccountAssignment {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation("AccountAssignmentUser", fields: [userId], references: [id])
  customerTenantId  String
  customerTenant    Tenant    @relation("AccountAssignmentCustomerTenant", fields: [customerTenantId], references: [id])
  validFrom         DateTime
  validTo           DateTime?
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("AccountAssignmentCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("AccountAssignmentUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("AccountAssignmentDeactivatedBy", fields: [deactivatedById], references: [id])

  @@unique([userId, customerTenantId, validFrom])
  @@index([userId])
}

/// Vertretung (`delegation`, SPEC 3.11, Regeln in 2.4) — befristete
/// Übertragung der Rechte einer Rollenzuweisung auf eine andere Person
/// derselben Organisation.
///
/// `periodFrom` und `periodTo` sind beide Pflicht: unbefristete Vertretungen
/// gibt es nicht (2.4, Regel 1). Keine Ketten, keine Rechteerweiterung, kein
/// Übergang über Organisationsgrenzen — geprüft in lib/authz/grants.ts, weil
/// es Bedingungen über mehrere Sätze hinweg sind.
model Delegation {
  id                        String         @id @default(cuid())
  delegatedRoleAssignmentId String
  delegatedRoleAssignment   RoleAssignment @relation(fields: [delegatedRoleAssignmentId], references: [id])
  delegateUserId            String
  delegateUser              User           @relation("DelegationDelegateUser", fields: [delegateUserId], references: [id])
  tenantId                  String
  tenant                    Tenant         @relation(fields: [tenantId], references: [id])
  periodFrom                DateTime
  periodTo                  DateTime
  reason                    String?
  revokedAt                 DateTime?
  revokedById               String?
  revokedBy                 User?          @relation("DelegationRevokedBy", fields: [revokedById], references: [id])
  externalReference         String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("DelegationCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("DelegationUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("DelegationDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([delegatedRoleAssignmentId])
  @@index([delegateUserId])
  @@index([tenantId])
}

// ───────────────────────────────────────────────────────────────────────────
// Fachmodule 3.1 bis 3.5
//
// Konventionen aus 3.0, die in jedem Modell dieses Abschnitts wiederkehren:
//
//  - Standardfelder `id`, `createdAt`/`createdById`, `updatedAt`/`updatedById`,
//    `deactivatedAt`/`deactivatedById` und `externalReference` (Frage 7).
//  - `tenantId` bei jedem **mandantengebundenen** Objekt. Unterobjekte
//    (Preisposition, Anforderung, Angebotsposition, Ansprechpartner) tragen
//    **keinen** eigenen Mandanten: sie gehören zum Mandanten ihres
//    Hauptobjekts und teilen nach 2.2 (Lesart) auch dessen Matrixzeile. Der
//    Mandant wird deshalb über das Hauptobjekt gelesen, nicht doppelt geführt.
//  - Gültigkeitszeiträume halb offen: `validTo` leer heißt unbefristet (3.0,
//    Festlegung 2). Stammdaten werden nicht überschrieben, wenn sich ein Wert
//    mit Wirkung für die Zukunft ändert — dann entsteht ein neuer Zeitraum.
//  - Geldbeträge als Dezimalwert mit Währung (3.0, Festlegung 1).
//  - `status` nur dort, wo ein Statusmodell existiert. Die Übergänge stehen
//    als geschlossene Menge in lib/status/, nicht im Schema: die Datenbank
//    kennt die Zustände, die zulässigen Wechsel kennt Kapitel 4.
// ───────────────────────────────────────────────────────────────────────────

/// Lieferantenstatus (3.2, Statusmodell 4.6).
enum SupplierStatus {
  onboarding
  active
  blocked
  inactive
}

/// Erlaubnisart (3.2): befristet oder unbefristet erteilt.
enum PermitType {
  fixedTerm
  unlimited
}

/// Anerkennungsstatus eines Nachweises (3.2, 3.10, Nachweisfluss 5.4.3).
enum VerificationStatus {
  submitted
  accepted
  rejected
}

/// Vertragsart (3.3): der Prototyp kennt nur zwei Vertragsstrecken —
/// Betreiber ↔ Kunde und Betreiber ↔ Lieferant.
enum AgreementType {
  customerAgreement
  supplierAgreement
}

/// Vertragsstatus (3.3). Kapitel 4 führt dafür heute kein Modell; die vier
/// Werte sind der fachlich benötigte Mindestumfang.
enum AgreementStatus {
  draft
  active
  expired
  terminated
}

/// Seite einer Preisliste (3.3). Die Trennung ist wesentlich: Kundenrollen
/// sehen nie die Einkaufsseite, Lieferantenrollen nie die Kundenseite
/// (Fußnoten [41] und [42] in 2.2).
enum RateCardScope {
  supplierRateCard
  customerRateCard
}

/// Preislistenstatus (3.3); kein Modell in Kapitel 4.
enum RateCardStatus {
  draft
  active
  expired
}

/// Positionsart einer Preisposition (3.3): Grundsatz oder Zuschlagssatz.
enum RateCardItemType {
  baseRate
  premiumRate
}

/// Zielobjekt einer Tarifzuordnung (3.3).
enum CollectiveAgreementTarget {
  supplier
  customer
  site
}

/// Herkunft der Entgeltangabe (3.3). `estimate` ist für 5.2 nur eine
/// Warnung, kein Nachweis.
enum WageSource {
  collectiveAgreement
  companyAgreement
  individualContract
  estimate
}

/// Zustände der Bedarfsanfrage (3.4, Statusmodell 4.1).
enum DemandRequestStatus {
  draft
  submitted
  approved
  tendered
  inSelection
  filled
  cancelled
  expired
}

/// Anforderung einer Bedarfsanfrage: Pflicht oder Wunsch (3.4).
enum RequirementKind {
  mandatory
  desired
}

/// Verteilungsart einer Ausschreibung (3.5).
enum DistributionMode {
  simultaneous
  staged
}

/// Zustände der Einladung (3.5, Statusmodell 4.2.1).
enum InvitationStatus {
  invited
  viewed
  offerSubmitted
  declined
  expired
}

/// Beschäftigungsverhältnis des Kandidaten beim Verleiher (3.6). Die
/// Überlassung setzt ein Arbeitsverhältnis beim Verleiher voraus; geprüft wird
/// das in 5.3.4 (P11), nicht hier.
enum EmploymentStatusWithSupplier {
  employed
  applicant
}

/// Kandidatenstatus (3.6). Kapitel 4 führt dafür **kein** Modell — der
/// Vorgangsstatus hängt am Profilvorschlag (4.2.3) und am Einsatz (4.3).
enum CandidateStatus {
  active
  inactive
}

/// Offenlegungsstufe eines Profilvorschlags (3.6) — die technische Umsetzung
/// der Datenminimierung: der Kunde sieht ein pseudonymisiertes Profil,
/// Klardaten erst nach Zusage ([23], 6.4).
enum DisclosureLevel {
  pseudonymized
  identified
}

/// Zustände des Profilvorschlags (3.6, Statusmodell 4.2.3).
enum CandidateSubmissionStatus {
  draft
  submitted
  reviewed
  releasedToCustomer
  interviewScheduled
  accepted
  rejected
  withdrawn
}

/// Fachliche Entscheidung am Profilvorschlag (3.6) — sie trifft der
/// Bedarfsträger ([24]), nicht der Betreiber.
enum SubmissionDecision {
  accepted
  rejected
}

/// Stand einer Verknüpfung von Kandidatensatz und Personenidentität (3.6,
/// Entscheidung zu vormals offener Frage 18): der Abgleich **schlägt vor**, er
/// verknüpft nicht selbst. Ein nur vorgeschlagener Treffer gilt nicht als
/// Identität und löst keine AÜG-Prüfung aus (4.2.3, „Grundlage von P1 und P6").
enum IdentityLinkStatus {
  proposed
  confirmed
  detached
}

/// Handlung der Verknüpfungshistorie (`mergeHistory`, 3.6). Zusammenführen und
/// Trennen bleiben nachvollziehbar; eine falsche Verknüpfung muss rückholbar
/// sein, ohne die Historie zu verlieren.
enum IdentityMergeAction {
  proposed
  confirmed
  detached
}

/// Zustände des Einsatzes (3.7, Statusmodell 4.3.1).
///
/// „Verlängert" ist **kein** Zustand: eine wirksame Verlängerung verschiebt
/// `plannedEndDate` und lässt den Einsatz in `planned` bzw. `active` (4.3.1).
/// Ein beantragter Beendigungsvorgang hat ebenfalls keinen Zustand.
enum AssignmentStatus {
  planned
  active
  interrupted
  completed
  terminatedEarly
}

/// Zustände der Verlängerung (3.7, Statusmodell 4.3.2).
enum AssignmentExtensionStatus {
  requested
  approved
  rejected
  effective
  withdrawn
}

/// Ergebnisart einer AÜG-Prüfung (5.5.2), als *abgeleitetes* Feld am Vorgang
/// geführt (`ruleCheckResult`, 3.7). Die Werte entsprechen `Ergebnisart` in
/// `lib/aueg/typen.ts` (`information`, `warnung`, `sperre`); die Bezeichner
/// sind hier englisch (CLAUDE.md, Sprache). Gerechnet wird der Wert in
/// Kapitel 5 — dieses Feld hält nur das Ergebnis.
enum RuleCheckResult {
  information
  warning
  block
}

/// Zustände des Lieferantenangebots (3.5, Statusmodell 4.2.2).
enum SupplierOfferStatus {
  draft
  submitted
  reviewed
  accepted
  rejected
  withdrawn
  expired
}

/// Kunde (`customer`, SPEC 3.1) — die Entleiher-Organisation.
///
/// Der Kunde **ist** ein Mandant: zu jedem Kunden gehört genau ein `tenant`
/// mit `tenantType = customer` (3.1). Die Beziehung ist deshalb 1 : 1 und
/// `tenantId` eindeutig.
///
/// Rechtliche Fristen des AÜG, insbesondere die Höchstüberlassungsdauer
/// (5.1), zählen **je Kunde** — nicht je Standort und nicht je Kostenstelle.
model Customer {
  id                            String                         @id @default(cuid())
  tenantId                      String                         @unique
  tenant                        Tenant                         @relation("CustomerTenant", fields: [tenantId], references: [id])
  customerNumber                String                         @unique
  legalName                     String
  legalForm                     String?
  addressStreet                 String
  addressPostalCode             String
  addressCity                   String
  addressCountry                String
  commercialRegisterNumber      String?
  industrySector                String?
  corporateGroup                String?
  /// Tarifbindung des Entleihers (3.1) — Grundlage für Equal Pay (5.2).
  customerCollectiveAgreementId String?
  customerCollectiveAgreement   CollectiveAgreementAssignment? @relation("CustomerCollectiveAgreement", fields: [customerCollectiveAgreementId], references: [id])
  /// Eskalationsfristen je Kunde (2.4, Regel 5; Schlüssel und Vorbelegungen
  /// in 4.0). Satz von Fristwerten in Tagen, deshalb ein Schlüssel-Wert-Satz
  /// und keine Spalte je Frist.
  processDeadlineConfig         Json?
  validFrom                     DateTime
  validTo                       DateTime?
  externalReference             String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("CustomerDeactivatedBy", fields: [deactivatedById], references: [id])

  contacts                       ContactPerson[]                 @relation("CustomerContacts")
  sites                          Site[]
  costCenters                    CostCenter[]
  masterAgreements               MasterAgreement[]               @relation("CustomerMasterAgreements")
  demandRequests                 DemandRequest[]
  collectiveAgreementAssignments CollectiveAgreementAssignment[] @relation("CustomerCollectiveAgreementTarget")
  assignments                    Assignment[]
}

/// Ansprechpartner (3.1, 3.2) — personenbezogene Kontaktangabe zu einem
/// Kunden, einem Standort oder einem Lieferanten.
///
/// Unterobjekt ohne eigenen Mandanten: es gehört dem Mandanten seines
/// Eigentümers. Genau einer der drei Verweise ist gesetzt; die Bedingung
/// steht in lib/masterdata/invariants.ts, weil Prisma „genau einer von
/// dreien" nicht ausdrücken kann.
model ContactPerson {
  id                String    @id @default(cuid())
  customerId        String?
  customer          Customer? @relation("CustomerContacts", fields: [customerId], references: [id])
  siteId            String?
  site              Site?     @relation("SiteContacts", fields: [siteId], references: [id])
  supplierId        String?
  supplier          Supplier? @relation("SupplierContacts", fields: [supplierId], references: [id])
  name              String
  function          String?
  email             String?
  phone             String?
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("ContactCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("ContactUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("ContactDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([customerId])
  @@index([siteId])
  @@index([supplierId])
}

/// Standort (`site`, SPEC 3.1) — der konkrete Einsatzort beim Kunden.
///
/// Er trägt die Angaben, die die Kennzeichnungs- und Konkretisierungspflicht
/// des Überlassungsvertrags verlangt (§ 1 Abs. 1 AÜG, 5.3), und die Grundlage
/// der Unterweisungspflicht (`safetyBriefingRequired`, 3.10 und 5.4).
model Site {
  id                              String                         @id @default(cuid())
  tenantId                        String
  tenant                          Tenant                         @relation(fields: [tenantId], references: [id])
  customerId                      String
  customer                        Customer                       @relation(fields: [customerId], references: [id])
  siteNumber                      String
  name                            String
  addressStreet                   String
  addressPostalCode               String
  addressCity                     String
  addressCountry                  String
  /// Betriebsvereinbarung (3.1) — Verweis auf `document` (3.10). Das Objekt
  /// ist noch nicht modelliert; bis dahin ein benannter Skalar.
  worksCouncilAgreementRef        String?
  /// Branchenzuschlag je Einsatzbranche (5.2).
  collectiveAgreementAssignmentId String?
  collectiveAgreementAssignment   CollectiveAgreementAssignment? @relation("SiteCollectiveAgreement", fields: [collectiveAgreementAssignmentId], references: [id])
  /// Regelarbeitszeit in Stunden je Woche; Vorbelegung für Bedarfsanfrage
  /// und Einsatz.
  standardWeeklyHours             Decimal?                       @db.Decimal(5, 2)
  safetyBriefingRequired          Boolean
  validFrom                       DateTime
  validTo                         DateTime?
  externalReference               String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("SiteCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("SiteUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("SiteDeactivatedBy", fields: [deactivatedById], references: [id])

  contacts                       ContactPerson[]                 @relation("SiteContacts")
  costCenters                    CostCenter[]
  demandRequests                 DemandRequest[]
  rateCardItems                  RateCardItem[]
  comparableWageEntries          ComparableWageEntry[]
  collectiveAgreementAssignments CollectiveAgreementAssignment[] @relation("SiteCollectiveAgreementTarget")
  assignments                    Assignment[]

  // Fachliche Kennung, eindeutig je Kunde (3.1).
  @@unique([customerId, siteNumber])
  @@index([tenantId])
}

/// Kostenstelle (`costCenter`, SPEC 3.1) — die kaufmännische Zuordnung eines
/// Bedarfs oder Einsatzes innerhalb der Kundenorganisation.
///
/// Sie ist eine interne Zuordnung des Kunden und für Lieferanten **nie**
/// sichtbar (Fußnote [14] in 2.2). Die Zeile in 2.2 trägt für `LD` und `LA`
/// deshalb kein Recht.
model CostCenter {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id])
  costCenterNumber  String
  name              String
  siteId            String?
  site              Site?     @relation(fields: [siteId], references: [id])
  /// Verantwortlich (3.1) — wer die Zuständigkeit pflegt, ist offene Frage 14.
  responsibleUserId String?
  responsibleUser   User?     @relation("CostCenterResponsibleUser", fields: [responsibleUserId], references: [id])
  budgetAmount      Decimal?  @db.Decimal(14, 2)
  budgetCurrency    String?
  validFrom         DateTime
  validTo           DateTime?
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("CostCenterCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("CostCenterUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("CostCenterDeactivatedBy", fields: [deactivatedById], references: [id])

  demandRequests DemandRequest[]
  assignments    Assignment[]

  @@unique([customerId, costCenterNumber])
  @@index([tenantId])
}

/// Lieferant (`supplier`, SPEC 3.2) — ein Sub-Verleiher, der dem Betreiber
/// Personal zur Überlassung stellt.
///
/// Der Lieferant **ist** ein Mandant (`tenantType = supplier`), die Beziehung
/// deshalb 1 : 1. Stammdatenhoheit: Betreiber (`MA`) für Nummer, Status und
/// Freischaltung; der Lieferantenadministrator (`LA`) pflegt die eigenen
/// Angaben ([7]).
///
/// `supplierCollectiveAgreementId` ist nach 3.2 **Pflicht ab Status
/// `active`** — eine Bedingung über zwei Felder, die das Schema nicht
/// erzwingen kann; sie steht in lib/masterdata/invariants.ts.
model Supplier {
  id                            String                         @id @default(cuid())
  tenantId                      String                         @unique
  tenant                        Tenant                         @relation("SupplierTenant", fields: [tenantId], references: [id])
  supplierNumber                String                         @unique
  legalName                     String
  legalForm                     String?
  addressStreet                 String
  addressPostalCode             String
  addressCity                   String
  addressCountry                String
  commercialRegisterNumber      String?
  supplierCollectiveAgreementId String?
  supplierCollectiveAgreement   CollectiveAgreementAssignment? @relation("SupplierCollectiveAgreement", fields: [supplierCollectiveAgreementId], references: [id])
  status                        SupplierStatus
  blockReason                   String?
  blockedAt                     DateTime?
  blockedById                   String?
  blockedBy                     User?                          @relation("SupplierBlockedBy", fields: [blockedById], references: [id])
  validFrom                     DateTime
  validTo                       DateTime?
  externalReference             String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("SupplierCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("SupplierUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("SupplierDeactivatedBy", fields: [deactivatedById], references: [id])

  contacts                       ContactPerson[]                 @relation("SupplierContacts")
  permits                        SupplierPermit[]
  masterAgreements               MasterAgreement[]               @relation("SupplierMasterAgreements")
  invitations                    TenderInvitation[]
  offers                         SupplierOffer[]
  collectiveAgreementAssignments CollectiveAgreementAssignment[] @relation("SupplierCollectiveAgreementTarget")
  candidates                     Candidate[]
  assignments                    Assignment[]
}

/// AÜG-Erlaubnis (`supplierPermit`, SPEC 3.2) — der Nachweis, dass ein
/// Lieferant Arbeitnehmerüberlassung betreiben darf (§ 1 AÜG).
///
/// Das Objekt trägt die **Daten** der Erlaubnis; die **Urkunde** ist ein
/// Dokument nach 3.10 (`certificateDocumentRef`, dort noch nicht modelliert).
/// Eine Verlängerung erzeugt einen **neuen** Satz (`supersedesId`), der alte
/// bleibt erhalten — Historisierung nach 3.0.
///
/// Die Fristenüberwachung und die Sperrwirkung regelt 5.4 und ist nicht Teil
/// dieser Arbeitseinheit; geführt werden Gültigkeit und Anerkennung.
model SupplierPermit {
  id                     String             @id @default(cuid())
  tenantId               String
  tenant                 Tenant             @relation(fields: [tenantId], references: [id])
  supplierId             String
  supplier               Supplier           @relation(fields: [supplierId], references: [id])
  permitNumber           String
  issuingAuthority       String
  permitType             PermitType
  issuedOn               DateTime
  validFrom              DateTime
  /// Pflicht bei `fixedTerm`, leer bei `unlimited` (3.2) — Bedingung über
  /// zwei Felder, geprüft in lib/masterdata/invariants.ts.
  validTo                DateTime?
  restrictions           String?
  /// Urkunde (3.2, Nachweisart `permitCertificate`) — Verweis auf `document`
  /// (3.10). Nach 3.2 Pflicht; solange 3.10 nicht modelliert ist, bleibt der
  /// Verweis optional. Die Abweichung ist in PROGRESS.md benannt.
  certificateDocumentRef String?
  verificationStatus     VerificationStatus
  verifiedAt             DateTime?
  verifiedById           String?
  verifiedBy             User?              @relation("PermitVerifiedBy", fields: [verifiedById], references: [id])
  rejectionReason        String?
  supersedesId           String?            @unique
  supersedes             SupplierPermit?    @relation("PermitSupersedes", fields: [supersedesId], references: [id])
  supersededBy           SupplierPermit?    @relation("PermitSupersedes")
  externalReference      String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("PermitCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("PermitUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("PermitDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([tenantId])
  @@index([supplierId])
}

/// Rahmenvertrag (`masterAgreement`, SPEC 3.3) — die vertragliche Grundlage
/// zwischen dem Betreiber und **einem** anderen Mandanten.
///
/// Er gehört dem **Betreiber** (`tenantType = operator`) und ist der
/// Gegenpartei zugeordnet. Genau einer der beiden Verweise `customerId` und
/// `supplierId` ist gesetzt, passend zu `agreementType` — geprüft in
/// lib/masterdata/invariants.ts.
model MasterAgreement {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  agreementNumber   String          @unique
  agreementType     AgreementType
  customerId        String?
  customer          Customer?       @relation("CustomerMasterAgreements", fields: [customerId], references: [id])
  supplierId        String?
  supplier          Supplier?       @relation("SupplierMasterAgreements", fields: [supplierId], references: [id])
  validFrom         DateTime
  validTo           DateTime?
  noticePeriodDays  Int?
  /// Kaufmännische Angabe, keine Zahlungsabwicklung (1.4).
  paymentTermsDays  Int?
  status            AgreementStatus
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("AgreementCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("AgreementUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("AgreementDeactivatedBy", fields: [deactivatedById], references: [id])

  rateCards RateCard[]

  @@index([tenantId])
  @@index([customerId])
  @@index([supplierId])
}

/// Preisliste (`rateCard`, SPEC 3.3) — die Konditionen zu einem
/// Rahmenvertrag.
///
/// `rateCardScope` muss zur Vertragsart passen (3.3): die Einkaufsseite
/// gehört zu einem Lieferantenvertrag, die Kundenseite zu einem
/// Kundenvertrag. Die Differenz der beiden Seiten ist die Marge des
/// Betreibers und für beide Gegenseiten unsichtbar ([41], [42] in 2.2).
///
/// Preisrunden erzeugen **neue** Listen, keine Änderung der alten (3.3).
model RateCard {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  rateCardNumber    String          @unique
  masterAgreementId String
  masterAgreement   MasterAgreement @relation(fields: [masterAgreementId], references: [id])
  rateCardScope     RateCardScope
  validFrom         DateTime
  validTo           DateTime?
  currency          String
  status            RateCardStatus
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("RateCardCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("RateCardUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("RateCardDeactivatedBy", fields: [deactivatedById], references: [id])

  items RateCardItem[]

  @@index([tenantId])
  @@index([masterAgreementId])
}

/// Preisposition (`rateCardItem`, SPEC 3.3) — eine Kondition der Preisliste.
///
/// Unterobjekt der Preisliste: es teilt deren Matrixzeile (2.2, Lesart) und
/// deren Mandanten. `itemType` trennt Grundsatz von Zuschlagssatz; die
/// Pflichtfelder hängen daran (3.3) und werden in
/// lib/masterdata/invariants.ts geprüft.
model RateCardItem {
  id                  String           @id @default(cuid())
  rateCardId          String
  rateCard            RateCard         @relation(fields: [rateCardId], references: [id])
  itemType            RateCardItemType
  qualificationLevel  String?
  /// Engere Fassung als die Qualifikationsstufe (3.3).
  activityDescription String?
  siteId              String?
  site                Site?            @relation(fields: [siteId], references: [id])
  /// Zuschlagsart (3.8) — Katalog noch nicht modelliert, bis dahin ein
  /// benannter Skalar. Pflicht bei `premiumRate`.
  premiumTypeRef      String?
  hourlyRate          Decimal?         @db.Decimal(12, 4)
  /// Prozentsatz oder Betrag; die Berechnungsart kommt aus der Zuschlagsart
  /// (3.3, 3.8).
  premiumValue        Decimal?         @db.Decimal(12, 4)
  minimumHours        Decimal?         @db.Decimal(6, 2)
  validFrom           DateTime?
  validTo             DateTime?
  externalReference   String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("RateCardItemCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("RateCardItemUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("RateCardItemDeactivatedBy", fields: [deactivatedById], references: [id])

  offerItems          SupplierOfferItem[]
  // Einkaufs- und Verkaufsseite eines Einsatzes (3.7): beide Verweise zeigen
  // auf eine Preisposition, deshalb zwei benannte Beziehungen.
  agreedAssignments   Assignment[]        @relation("AssignmentAgreedRate")
  customerAssignments Assignment[]        @relation("AssignmentCustomerRate")

  @@index([rateCardId])
}

/// Tarifzuordnung (`collectiveAgreementAssignment`, SPEC 3.3) — ordnet einem
/// Lieferanten, einem Kunden oder einem Standort den anzuwendenden
/// Tarifvertrag zu.
///
/// Der Tarifkatalog ist **Konfiguration**, kein festverdrahteter Wertebereich
/// (Entscheidung zu offener Frage 3) — deshalb ein Textfeld und kein Enum.
/// Das Objekt hält die Zuordnung und ihre Parameter; die Rechenregeln stehen
/// in 5.1 und 5.2.
model CollectiveAgreementAssignment {
  id                          String                    @id @default(cuid())
  tenantId                    String
  tenant                      Tenant                    @relation(fields: [tenantId], references: [id])
  collectiveAgreement         String
  appliesToType               CollectiveAgreementTarget
  supplierId                  String?
  supplierTarget              Supplier?                 @relation("SupplierCollectiveAgreementTarget", fields: [supplierId], references: [id])
  customerId                  String?
  customerTarget              Customer?                 @relation("CustomerCollectiveAgreementTarget", fields: [customerId], references: [id])
  siteId                      String?
  siteTarget                  Site?                     @relation("SiteCollectiveAgreementTarget", fields: [siteId], references: [id])
  validFrom                   DateTime
  validTo                     DateTime?
  /// Tarifliche oder betriebliche Abweichung von 18 Monaten (5.1);
  /// leer = Regelgrenze.
  maxAssignmentDurationMonths Int?
  /// Abweichung von 9 Monaten (5.2); leer = Regelfrist.
  equalPayDeadlineMonths      Int?
  /// Stufenfolge der Branchenzuschläge (5.2).
  industryPremiumScheme       String?
  /// Rechtsgrundlage (Betriebsvereinbarung, Tarifauszug) — Verweis auf
  /// `document` (3.10), dort noch nicht modelliert.
  documentRef                 String?
  externalReference           String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("CaaCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("CaaUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("CaaDeactivatedBy", fields: [deactivatedById], references: [id])

  // Gegenrichtung der Tarifbindung aus 3.1 und 3.2.
  customersBoundTo Customer[] @relation("CustomerCollectiveAgreement")
  suppliersBoundTo Supplier[] @relation("SupplierCollectiveAgreement")
  sitesBoundTo     Site[]     @relation("SiteCollectiveAgreement")

  @@index([tenantId])
  @@index([supplierId])
  @@index([customerId])
  @@index([siteId])
}

/// Vergleichsentgelt (`comparableWageEntry`, SPEC 3.3) — das Entgelt eines
/// vergleichbaren Stammarbeitnehmers des Entleihers, Datengrundlage für
/// Equal Pay (5.2).
///
/// Geführt **je Tätigkeit am Standort** (Entscheidung zu offener Frage 15),
/// nicht je Einsatz und nicht je Kostenstelle. Mandant ist der **Kunde**: nur
/// der Entleiher kennt den Wert und pflegt ihn (`KE`, [2]). Für
/// Lieferantenrollen ist der Katalog nicht sichtbar — die Zeile in 2.2 trägt
/// für `LD` und `LA` kein Recht.
model ComparableWageEntry {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  siteId            String
  site              Site       @relation(fields: [siteId], references: [id])
  /// Dieselbe Fassung wie `activityDescription` in 3.4 und 3.7.
  activityKey       String
  comparableWage    Decimal    @db.Decimal(12, 4)
  currency          String
  validFrom         DateTime
  validTo           DateTime?
  wageSource        WageSource
  reportedAt        DateTime
  reportedById      String
  reportedBy        User       @relation("WageReportedBy", fields: [reportedById], references: [id])
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("WageCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("WageUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("WageDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([tenantId])
  @@index([siteId])
}

/// Bedarfsanfrage (`demandRequest`, SPEC 3.4) — der vom Kunden gemeldete
/// Personalbedarf.
///
/// Mandant ist der Kunde. Eigentümer ist der Bedarfsträger (`KB`); er darf
/// nur im Status `draft` ändern ([11]) und zur Freigabe einreichen ([12]).
/// Der `MD` darf im Auftrag des Kunden anlegen ([10], dann ist
/// `createdOnBehalfOfId` Pflicht), der `KG` freigeben oder zurückweisen
/// ([13]).
///
/// Statusmodell 4.1, umgesetzt als geschlossene Übergangsmenge in
/// lib/status/demandRequest.ts.
model DemandRequest {
  id                  String              @id @default(cuid())
  tenantId            String
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  requestNumber       String
  customerId          String
  customer            Customer            @relation(fields: [customerId], references: [id])
  siteId              String
  site                Site                @relation(fields: [siteId], references: [id])
  /// Für Lieferanten **nicht** sichtbar (Fußnote [14] in 2.2).
  costCenterId        String
  costCenter          CostCenter          @relation(fields: [costCenterId], references: [id])
  requestedById       String
  requestedBy         User                @relation("DemandRequestedBy", fields: [requestedById], references: [id])
  /// Kennzeichnung des Auftraggebers bei Anlage durch `MD` ([10]).
  createdOnBehalfOfId String?
  createdOnBehalfOf   User?               @relation("DemandOnBehalfOf", fields: [createdOnBehalfOfId], references: [id])
  title               String
  /// Konkretisierung der Tätigkeit (5.3, Prüfung P8).
  activityDescription String
  headcount           Int
  startDate           DateTime
  /// Leer = unbefristeter Bedarf; die Höchstüberlassungsdauer begrenzt ihn
  /// trotzdem (5.1).
  endDate             DateTime?
  weeklyHours         Decimal             @db.Decimal(5, 2)
  shiftPattern        String?
  /// Pflicht ab Status `tendered` (3.4); Eskalationsanlass (2.4, 4.2).
  offerDeadline       DateTime?
  /// Kostenrahmen, sichtbar nur für `KG` ([8]) und `KE` ([2]).
  maxHourlyRate       Decimal?            @db.Decimal(12, 4)
  currency            String?
  /// Für Lieferanten **nicht** sichtbar ([14]).
  internalNote        String?
  approvedAt          DateTime?
  approvedById        String?
  approvedBy          User?               @relation("DemandApprovedBy", fields: [approvedById], references: [id])
  cancellationReason  String?
  /// Begründung der Rückweisung `submitted` → `draft` durch `KG` (4.1); für
  /// den Bedarfsträger sichtbar, damit er weiß, was zu ändern ist.
  rejectionReason     String?
  status              DemandRequestStatus
  externalReference   String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("DemandCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("DemandUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("DemandDeactivatedBy", fields: [deactivatedById], references: [id])

  qualificationRequirements DemandRequestQualification[]
  tenders                   Tender[]
  candidateSubmissions      CandidateSubmission[]
  assignments               Assignment[]

  // Fachliche Kennung, eindeutig je Kunde (3.4).
  @@unique([customerId, requestNumber])
  @@index([tenantId])
  @@index([siteId])
  @@index([costCenterId])
  @@index([status])
}

/// Anforderung einer Bedarfsanfrage (3.4) — eine geforderte Qualifikation,
/// Pflicht oder Wunsch. Mindestens eine ist Pflicht; die Bedingung ist eine
/// Vorbedingung des Übergangs `draft` → `submitted` (4.1).
///
/// Unterobjekt der Bedarfsanfrage: teilt deren Mandanten und Matrixzeile.
model DemandRequestQualification {
  id                String          @id @default(cuid())
  demandRequestId   String
  demandRequest     DemandRequest   @relation(fields: [demandRequestId], references: [id])
  qualification     String
  requirementKind   RequirementKind
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("QualificationCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("QualificationUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("QualificationDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([demandRequestId])
}

/// Ausschreibung (`tender`, SPEC 3.5) — die vom Betreiber gesteuerte
/// Verteilung einer freigegebenen Bedarfsanfrage an ausgewählte Lieferanten.
///
/// Mandant ist der **Betreiber**: die Ausschreibung ist die Steuerungshandlung
/// des MSP. Der Kunde sieht nur Stand und Fortschritt zur eigenen Anfrage
/// ([15]), der Lieferant nur die eigene Einladung ([16]).
///
/// Eine Wiederholung ist eine **neue** Ausschreibung mit erhöhter
/// Rundennummer, keine Änderung der alten (3.5, 4.1).
///
/// Statusmodell: keines in Kapitel 4 — eine Ausschreibung ist offen bis
/// `closedAt`, der Fortschritt ergibt sich aus 4.1 und den Einladungen.
model Tender {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  tenderNumber      String           @unique
  demandRequestId   String
  demandRequest     DemandRequest    @relation(fields: [demandRequestId], references: [id])
  tenderRound       Int
  distributionMode  DistributionMode
  publishedAt       DateTime
  publishedById     String
  publishedBy       User             @relation("TenderPublishedBy", fields: [publishedById], references: [id])
  /// Kann die Frist der Anfrage je Runde verkürzen (3.5).
  offerDeadline     DateTime
  closedAt          DateTime?
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("TenderCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("TenderUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("TenderDeactivatedBy", fields: [deactivatedById], references: [id])

  invitations TenderInvitation[]

  @@unique([demandRequestId, tenderRound])
  @@index([tenantId])
}

/// Einladung (`tenderInvitation`, SPEC 3.5) — die Teilnahme genau **eines**
/// Lieferanten an einer Ausschreibung.
///
/// Sie ist das Objekt, an dem die Mandantengrenze zum Lieferanten hängt: die
/// Einladung gehört dem Betreiber, ist aber dem Lieferanten zugänglich. **Nie
/// sichtbar** sind die Teilnehmerliste der Ausschreibung, die Zahl der
/// Eingeladenen und die Zahl der eingegangenen Angebote (2.3).
///
/// Statusmodell 4.2.1, umgesetzt in lib/status/tenderInvitation.ts. Die
/// Absage der eigenen Einladung setzt der Lieferantendisponent selbst
/// (Fußnote [46], Entscheidung zu offener Frage 23).
model TenderInvitation {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  tenderId          String
  tender            Tender           @relation(fields: [tenderId], references: [id])
  supplierId        String
  supplier          Supplier         @relation(fields: [supplierId], references: [id])
  invitedAt         DateTime
  /// Grundlage für die Eskalation nach 4.2 (`invitationViewDeadlineDays`).
  viewedAt          DateTime?
  respondedAt       DateTime?
  declineReason     String?
  invitationStatus  InvitationStatus
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("InvitationUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("InvitationDeactivatedBy", fields: [deactivatedById], references: [id])

  offer SupplierOffer?

  // Je Ausschreibung genau eine Einladung je Lieferant (3.13).
  @@unique([tenderId, supplierId])
  @@index([tenantId])
  @@index([supplierId])
}

/// Lieferantenangebot (`supplierOffer`, SPEC 3.5) — die Antwort eines
/// Lieferanten auf eine Einladung: Verfügbarkeit, Menge, Preis.
///
/// Mandant ist der **Lieferant**. Je Einladung höchstens **ein** Angebot
/// (3.13) — deshalb ist `tenderInvitationId` eindeutig. Ein Angebot darf auch
/// ohne Kandidaten abgegeben werden; Profilvorschläge sind eigene Objekte
/// (3.6) und noch nicht modelliert.
///
/// Statusmodell 4.2.2, umgesetzt in lib/status/supplierOffer.ts.
model SupplierOffer {
  id                 String              @id @default(cuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  offerNumber        String
  tenderInvitationId String              @unique
  tenderInvitation   TenderInvitation    @relation(fields: [tenderInvitationId], references: [id])
  /// Abgeleitet aus der Einladung, zur Sichtbarkeitsprüfung mitgeführt (3.5).
  supplierId         String
  supplier           Supplier            @relation(fields: [supplierId], references: [id])
  availableFrom      DateTime
  /// Darf unter `headcount` der Anfrage liegen (3.5).
  offeredHeadcount   Int
  offerValidUntil    DateTime?
  /// Für den Kunden nur im Umfang von [18].
  note               String?
  submittedAt        DateTime?
  /// Ab hier keine Änderung mehr durch `LD` ([19]).
  reviewedAt         DateTime?
  withdrawnAt        DateTime?
  /// Begründung der Ablehnung — Pflicht und **ohne** Bezug auf ein fremdes
  /// Angebot (2.3, Regel 3).
  rejectionReason    String?
  status             SupplierOfferStatus
  externalReference  String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("OfferCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("OfferUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("OfferDeactivatedBy", fields: [deactivatedById], references: [id])

  items       SupplierOfferItem[]
  submissions CandidateSubmission[]

  // Fachliche Kennung, eindeutig je Lieferant (3.5).
  @@unique([supplierId, offerNumber])
  @@index([tenantId])
}

/// Angebotsposition (`supplierOfferItem`, SPEC 3.5) — Preis- und Mengenangabe
/// eines Angebots je Qualifikation.
///
/// Unterobjekt des Angebots: teilt dessen Mandanten und Matrixzeile (2.2,
/// Lesart). Der Verrechnungssatz ist die **Einkaufsseite** und für
/// Kundenrollen nicht sichtbar (3.3, [18] in 2.2).
///
/// Nicht geführt: die Liste `premiumRates` aus 3.5 — sie verweist auf die
/// Zuschlagsart aus 3.8, die noch nicht modelliert ist.
model SupplierOfferItem {
  id                  String        @id @default(cuid())
  supplierOfferId     String
  supplierOffer       SupplierOffer @relation(fields: [supplierOfferId], references: [id])
  qualificationLevel  String
  headcount           Int
  hourlyRate          Decimal       @db.Decimal(12, 4)
  currency            String
  /// Gesetzt, wenn der Satz aus der Einkaufspreisliste kommt (3.5).
  rateCardItemId      String?
  rateCardItem        RateCardItem? @relation(fields: [rateCardItemId], references: [id])
  /// Pflicht bei Abweichung von der Preisliste (3.5, offene Frage 17).
  rateDeviationReason String?
  externalReference   String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("OfferItemCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("OfferItemUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("OfferItemDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([supplierOfferId])
}

// ───────────────────────────────────────────────────────────────────────────
// Fachmodule 3.6 und 3.7 — Besetzung
//
// Dieselben Konventionen wie oben (3.0): Standardfelder auf jedem Objekt,
// `tenantId` nur beim mandantengebundenen Hauptobjekt, Unterobjekte ohne
// eigenen Mandanten, Geldbeträge als Dezimalwert mit Währung, `status` nur, wo
// Kapitel 4 ein Modell führt.
//
// Noch nicht modelliert und deshalb als **benannter Skalar** geführt: der
// Nachweis zu einer Qualifikation (`documentRef`, 3.10) und das Schichtmodell
// als Katalogwert (3.7).
// ───────────────────────────────────────────────────────────────────────────

/// Kandidat (`candidate`, SPEC 3.6) — eine Person, die ein Lieferant für
/// Überlassungen führt.
///
/// Mandant ist der **Lieferant**; er ist Eigentümer der Personendaten. Der
/// Betreiber darf die fachlichen Angaben **nicht** ändern, sondern nur
/// Pseudonymisierung und Sichtbarkeitsfreigabe ([22]). Der Kunde sieht den
/// Kandidaten nur im Umfang der Datenminimierung ([23], 6.4) — abgebildet über
/// die Offenlegungsstufe am Profilvorschlag, nicht über ein Feld hier.
///
/// **Keine besonderen Kategorien nach Art. 9 DSGVO** (3.6, Festlegung):
/// arbeitsmedizinische Eignung und Ähnliches werden ausschließlich als
/// *Vorliegen und Gültigkeit* geführt (3.10), nicht inhaltlich.
///
/// Statusmodell: keines in Kapitel 4; `status` ist aktiv/inaktiv (3.6).
model Candidate {
  id                           String                       @id @default(cuid())
  tenantId                     String
  tenant                       Tenant                       @relation(fields: [tenantId], references: [id])
  candidateNumber              String
  supplierId                   String
  supplier                     Supplier                     @relation(fields: [supplierId], references: [id])
  /// Klardaten; ihre Sichtbarkeit gegenüber dem Kunden regelt 6.4 über die
  /// Offenlegungsstufe des Profilvorschlags.
  givenName                    String
  familyName                   String
  /// Nötig für den Identitätsabgleich (3.6) und die Drehtürprüfung (5.3).
  dateOfBirth                  DateTime
  /// Dritter Merkmalssatz des Abgleichs (3.6, abschließend). Am Kandidaten
  /// optional, weil 3.6 ihn in der Attributtabelle nicht als Pflicht führt;
  /// ohne ihn bleibt der Abgleich auf Name und Geburtsdatum beschränkt.
  placeOfBirth                 String?
  /// Für den Kunden erst nach Zusage ([23]).
  contactEmail                 String?
  contactPhone                 String?
  /// Anzeigeform für das pseudonymisierte Profil (6.4) — Pflicht.
  pseudonym                    String
  employmentStatusWithSupplier EmploymentStatusWithSupplier
  /// Pflicht bei `employed` (3.6); Grundlage von P11 (5.3.4).
  employedSince                DateTime?
  workPermitRequired           Boolean
  /// Erklärung zur Vorbeschäftigung (3.6). Herkunft und Form sind in 5.3.1
  /// **abschließend** festgelegt: Erklärung des Kandidaten, vom Verleiher
  /// eingeholt, mit der Angabe, ob in den letzten sechs Monaten ein
  /// Arbeitsverhältnis beim Entleiher oder im Konzern bestand, dem Ende dieses
  /// Verhältnisses und dem Datum der Erklärung. Die vier Felder sind genau
  /// dieser Inhalt — nicht mehr.
  previousEmploymentDeclaredAt DateTime?
  previousEmploymentExisted    Boolean?
  previousEmploymentEndedOn    DateTime?
  /// Früherer Arbeitgeber, bezogen auf den Entleiher oder dessen Konzern
  /// (5.3.1, Schritt 4).
  previousEmploymentEmployer   String?
  /// Nur beim Betreiber sichtbar (3.6, [43]). Gesetzt **ausschließlich** bei
  /// bestätigter Verknüpfung: ein nur vorgeschlagener Treffer gilt nicht als
  /// Identität (Entscheidung zu Frage 18) und steht allein in
  /// `WorkerIdentityLink` mit `linkStatus = proposed`.
  workerIdentityId             String?
  workerIdentity               WorkerIdentity?              @relation(fields: [workerIdentityId], references: [id])
  status                       CandidateStatus
  externalReference            String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("CandidateCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("CandidateUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("CandidateDeactivatedBy", fields: [deactivatedById], references: [id])

  qualifications CandidateQualification[]
  submissions    CandidateSubmission[]
  assignments    Assignment[]
  identityLinks  WorkerIdentityLink[]
  mergeEntries   WorkerIdentityMergeEntry[]

  // Fachliche Kennung, eindeutig je Lieferant (3.6).
  @@unique([supplierId, candidateNumber])
  @@index([tenantId])
  @@index([workerIdentityId])
  // Der Abgleich sucht über den abschließenden Merkmalssatz (3.6).
  @@index([familyName, dateOfBirth])
}

/// Qualifikation eines Kandidaten (3.6) — „Liste (Qualifikation, Nachweis)".
///
/// Unterobjekt des Kandidaten: teilt dessen Mandanten und Matrixzeile. Der
/// Nachweis ist ein Dokument nach 3.10 und dort noch nicht modelliert; bis
/// dahin ein benannter Skalar.
model CandidateQualification {
  id                String    @id @default(cuid())
  candidateId       String
  candidate         Candidate @relation(fields: [candidateId], references: [id])
  qualification     String
  documentRef       String?
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("CandidateQualificationCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("CandidateQualificationUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("CandidateQualificationDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([candidateId])
}

/// Profilvorschlag (`candidateSubmission`, SPEC 3.6) — das Vorlegen eines
/// Kandidaten auf eine konkrete Anfrage.
///
/// Mandant ist der **Lieferant** (der Vorschlag ist seine Handlung), mit
/// Statusführung gegenüber dem Kunden durch den `MD` ([17]) und fachlicher
/// Entscheidung durch den `KB` ([24]).
///
/// Derselbe Kandidat darf auf mehrere Anfragen vorgeschlagen werden; jeder
/// Vorschlag hat **seinen eigenen** Status und seine eigene Offenlegungsstufe
/// (3.6, 3.13).
///
/// Statusmodell 4.2.3, umgesetzt als geschlossene Übergangsmenge in
/// lib/status/candidateSubmission.ts.
model CandidateSubmission {
  id                   String                    @id @default(cuid())
  tenantId             String
  tenant               Tenant                    @relation(fields: [tenantId], references: [id])
  submissionNumber     String
  candidateId          String
  candidate            Candidate                 @relation(fields: [candidateId], references: [id])
  /// Bestimmt Einladung, Ausschreibung und Anfrage (3.6).
  supplierOfferId      String
  supplierOffer        SupplierOffer             @relation(fields: [supplierOfferId], references: [id])
  /// *Abgeleitet* aus dem Angebot, zur Prüfung der Sichtbarkeit mitgeführt.
  demandRequestId      String
  demandRequest        DemandRequest             @relation(fields: [demandRequestId], references: [id])
  /// Pflicht ab Status `submitted`; im Entwurf leer (3.6, 4.2.3).
  submittedAt          DateTime?
  availableFrom        DateTime
  /// Abweichender Satz, wenn er von der Angebotsposition abweicht — *offene
  /// Frage 17*.
  offeredHourlyRate    Decimal?                  @db.Decimal(12, 4)
  currency             String?
  /// Klardaten erst nach Zusage ([23], 6.4). Der Übergang nach
  /// `releasedToCustomer` **ist** die Umsetzung der Datenminimierung; eine
  /// Vorlage mit Klardaten ist unzulässig (4.2.3, Ausgeschlossen).
  disclosureLevel      DisclosureLevel
  /// Freigabe durch `MD` ([22]).
  releasedToCustomerAt DateTime?
  interviewScheduledAt DateTime?
  /// Fachlich durch `KB` ([24]).
  decision             SubmissionDecision?
  /// Pflicht bei `rejected`; enthält **nie** Bezug auf ein fremdes Angebot
  /// (2.3, Regel 3).
  decisionReason       String?
  decidedAt            DateTime?
  decidedById          String?
  decidedBy            User?                     @relation("SubmissionDecidedBy", fields: [decidedById], references: [id])
  /// Durch `LD` ([20]).
  withdrawnAt          DateTime?
  status               CandidateSubmissionStatus
  externalReference    String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("SubmissionCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("SubmissionUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("SubmissionDeactivatedBy", fields: [deactivatedById], references: [id])

  assignment Assignment?

  // Fachliche Kennung, eindeutig je Mandant (3.0).
  @@unique([tenantId, submissionNumber])
  @@index([candidateId])
  @@index([supplierOfferId])
  @@index([demandRequestId])
  @@index([status])
}

/// Personenidentität (`workerIdentity`, SPEC 3.6) — die betreiberseitige
/// Information, dass Kandidatensätze verschiedener Lieferanten **dieselbe
/// Person** betreffen.
///
/// **Ausschließlich Betreibermandant.** Kunden und Lieferanten sehen das Objekt
/// nicht und erfahren auch nicht, dass es existiert ([43], 2.3 Regel 4).
/// Ergebnisse daraus erreichen sie nur als Information oder Sperre zum eigenen
/// Vorgang — nie als Historie.
///
/// Der Merkmalssatz ist **abschließend** (Entscheidung zu vormals offener
/// Frage 18): Name, Geburtsdatum, Geburtsort. Keine Sozialversicherungs-,
/// Steuer- oder Ausweisnummer. Die Rechtsgrundlage ist **offene Frage 25**.
///
/// Statusmodell: keines.
model WorkerIdentity {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  /// Betreiberweit eindeutig; nie an Kunden oder Lieferanten weitergegeben.
  identityNumber    String    @unique
  /// Abgleichmerkmale — der abschließende Merkmalssatz aus 3.6.
  matchGivenName    String
  matchFamilyName   String
  matchDateOfBirth  DateTime
  matchPlaceOfBirth String?
  /// Pflicht bei bestätigter Verknüpfung (3.6): maschinelle Vorschläge werden
  /// manuell bestätigt. Hier der Zeitpunkt der **ersten** Bestätigung; je
  /// Verknüpfung steht er an `WorkerIdentityLink`.
  confirmedAt       DateTime?
  confirmedById     String?
  confirmedBy       User?     @relation("IdentityConfirmedBy", fields: [confirmedById], references: [id])
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("IdentityCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("IdentityUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("IdentityDeactivatedBy", fields: [deactivatedById], references: [id])

  /// `linkedCandidates` aus 3.6 — mindestens einer, lieferantenübergreifend.
  links        WorkerIdentityLink[]
  /// `mergeHistory` aus 3.6 — fortschreibend, nie überschrieben.
  mergeHistory WorkerIdentityMergeEntry[]
  candidates   Candidate[]
  assignments  Assignment[]

  @@index([tenantId])
  @@index([matchFamilyName, matchDateOfBirth])
}

/// Eine Verknüpfung zwischen Personenidentität und Kandidatensatz (3.6,
/// `linkedCandidates`).
///
/// Sie trägt den Stand der Verknüpfung, weil der Abgleich **vorschlägt** und
/// nicht selbst verknüpft: ein Satz in `proposed` ist ein maschineller Treffer
/// ohne Wirkung, erst `confirmed` macht die Identität aus (Entscheidung zu
/// Frage 18, 4.2.3 „Grundlage von P1 und P6"). `detached` bleibt stehen, damit
/// eine zurückgenommene Verknüpfung nachvollziehbar ist.
///
/// Unterobjekt der Personenidentität: Betreibermandant, keine eigene
/// Matrixzeile.
model WorkerIdentityLink {
  id                String             @id @default(cuid())
  workerIdentityId  String
  workerIdentity    WorkerIdentity     @relation(fields: [workerIdentityId], references: [id])
  candidateId       String
  candidate         Candidate          @relation(fields: [candidateId], references: [id])
  linkStatus        IdentityLinkStatus
  /// Übereinstimmende Merkmale des Vorschlags, in Worten (3.6) — die
  /// Begründung, die der Betreiber bei der Bestätigung vor sich hat.
  proposalBasis     String
  proposedAt        DateTime
  confirmedAt       DateTime?
  confirmedById     String?
  confirmedBy       User?              @relation("LinkConfirmedBy", fields: [confirmedById], references: [id])
  detachedAt        DateTime?
  detachedById      String?
  detachedBy        User?              @relation("LinkDetachedBy", fields: [detachedById], references: [id])
  /// Begründung der letzten Handlung; bei `detached` Pflicht (3.6).
  reason            String?
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("LinkCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("LinkUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("LinkDeactivatedBy", fields: [deactivatedById], references: [id])

  // Je Identität und Kandidat genau eine Verknüpfung; ihr Stand ändert sich,
  // die Historie steht in `WorkerIdentityMergeEntry`.
  @@unique([workerIdentityId, candidateId])
  @@index([candidateId])
  @@index([linkStatus])
}

/// Verknüpfungshistorie (`mergeHistory`, SPEC 3.6) — Liste aus Zeitpunkt,
/// Handlung und Begründung.
///
/// Fortschreibend und nie überschrieben: „Zusammenführen und Trennen bleiben
/// nachvollziehbar; eine falsche Verknüpfung muss rückholbar sein, ohne die
/// Historie zu verlieren" (3.6). Deshalb ein eigener Satz je Handlung und
/// nicht nur Zeitstempel an der Verknüpfung.
model WorkerIdentityMergeEntry {
  id                String              @id @default(cuid())
  workerIdentityId  String
  workerIdentity    WorkerIdentity      @relation(fields: [workerIdentityId], references: [id])
  /// Betroffener Kandidatensatz; leer bei einer Handlung an der Identität
  /// selbst.
  candidateId       String?
  candidate         Candidate?          @relation(fields: [candidateId], references: [id])
  occurredAt        DateTime
  action            IdentityMergeAction
  reason            String
  /// Handelnde Person beim Betreiber; leer beim maschinellen Vorschlag (der
  /// Abgleich ist eine Systemhandlung, 4.0 Regel 10).
  actedById         String?
  actedBy           User?               @relation("MergeEntryActedBy", fields: [actedById], references: [id])
  externalReference String?

  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation("MergeEntryCreatedBy", fields: [createdById], references: [id])
  updatedAt   DateTime? @updatedAt
  updatedById String?
  updatedBy   User?     @relation("MergeEntryUpdatedBy", fields: [updatedById], references: [id])

  @@index([workerIdentityId])
  @@index([candidateId])
}

/// Einsatz (`assignment`, SPEC 3.7) — die konkrete Überlassung einer Person an
/// einen Kunden für einen Zeitraum.
///
/// **Eine** Person bei **einem** Kunden an **einem** Standort; mehrere Köpfe
/// einer Anfrage ergeben mehrere Einsätze. Mehrere **gleichzeitige** Einsätze
/// derselben Person beim selben Kunden sind zulässig (Entscheidung zu Frage 19);
/// für die Höchstüberlassungsdauer zählt 5.1 Kalendertage, überlappende Tage
/// genau einmal.
///
/// Mandant ist der **Betreiber**: der Einsatz ist das Objekt an der Nahtstelle
/// und gleichzeitig dem Kunden und dem Lieferanten zugänglich, jedem nur im
/// eigenen Umfang ([2], [7]). Anlegen, verlängern und beenden führt der `MD`
/// aus; Kunde und Lieferant beantragen ([25]), der Kunde genehmigt ([26]).
///
/// Statusmodell 4.3.1, umgesetzt in lib/status/assignment.ts.
model Assignment {
  id                            String               @id @default(cuid())
  tenantId                      String
  tenant                        Tenant               @relation(fields: [tenantId], references: [id])
  /// Betreiberweit eindeutig (3.7).
  assignmentNumber              String               @unique
  /// Bezugspunkt der Höchstüberlassungsdauer (5.1) — je Kunde, nicht je
  /// Standort und nicht je Kostenstelle.
  customerId                    String
  customer                      Customer             @relation(fields: [customerId], references: [id])
  siteId                        String
  site                          Site                 @relation(fields: [siteId], references: [id])
  /// Für Lieferanten **nicht** sichtbar (3.7, [14]).
  costCenterId                  String
  costCenter                    CostCenter           @relation(fields: [costCenterId], references: [id])
  /// Anzeige gegenüber dem Kunden nach *offener Frage 11*.
  supplierId                    String
  supplier                      Supplier             @relation(fields: [supplierId], references: [id])
  candidateId                   String
  candidate                     Candidate            @relation(fields: [candidateId], references: [id])
  /// Pflicht ab Status `planned` (3.7); nur Betreibersicht, Grundlage der
  /// Zählung nach 5.1. Gesetzt wird **nur** eine bestätigte Identität.
  workerIdentityId              String?
  workerIdentity                WorkerIdentity?      @relation(fields: [workerIdentityId], references: [id])
  /// Leer bei Einsatz ohne vorangegangene Anfrage (3.7).
  demandRequestId               String?
  demandRequest                 DemandRequest?       @relation(fields: [demandRequestId], references: [id])
  /// 1 Einsatz : 0..1 Profilvorschlag (3.6, 3.7).
  candidateSubmissionId         String?              @unique
  candidateSubmission           CandidateSubmission? @relation(fields: [candidateSubmissionId], references: [id])
  /// Konkretisierungspflicht (5.3.3): **nicht** nur ein Verweis auf die
  /// Anfrage.
  activityDescription           String
  plannedStartDate              DateTime
  plannedEndDate                DateTime?
  actualStartDate               DateTime?
  actualEndDate                 DateTime?
  weeklyHours                   Decimal              @db.Decimal(5, 2)
  /// Katalogwert (3.7); der Katalog ist Konfiguration und noch nicht als
  /// Objekt geführt — bis dahin ein benannter Skalar.
  shiftModel                    String?
  /// Einkaufsseite (3.3).
  agreedRateCardItemId          String
  agreedRateCardItem            RateCardItem         @relation("AssignmentAgreedRate", fields: [agreedRateCardItemId], references: [id])
  /// Abweichender Satz und Begründung — *offene Frage 17*.
  agreedHourlyRate              Decimal?             @db.Decimal(12, 4)
  currency                      String?
  rateDeviationReason           String?
  /// Verkaufsseite; für Lieferanten **nie** sichtbar ([42], 3.3).
  customerRateCardItemId        String
  customerRateCardItem          RateCardItem         @relation("AssignmentCustomerRate", fields: [customerRateCardItemId], references: [id])
  /// Pflicht ab `equalPayDueDate` (3.7). Erbt beim Anlegen aus dem
  /// Vergleichsentgelt des Standorts zur Tätigkeit (3.3); eine Abweichung ist
  /// mit Begründung möglich und wird protokolliert.
  comparableWage                Decimal?             @db.Decimal(12, 4)
  comparableWageCurrency        String?
  comparableWageDeviationReason String?
  /// *Abgeleitet* — Ergebnis aus 5.2. Wird in Kapitel 5 gerechnet, nicht hier.
  equalPayDueDate               DateTime?
  /// *Abgeleitet* — Ergebnis aus 5.1.
  maxDurationEndDate            DateTime?
  /// *Abgeleitet*, einschließlich Vorläufern derselben Person beim selben
  /// Kunden (5.1).
  countedDurationDays           Int?
  /// Pflicht bei vorzeitiger Beendigung (3.7, 4.3.1).
  terminationReason             String?
  /// Pflicht bei Antrag (3.7): `KB` ([25]), `LD` ([25]) oder `MD`. Ein
  /// beantragter, noch nicht wirksamer Beendigungsvorgang hat **keinen**
  /// eigenen Zustand (4.3.1) — er ist nur über dieses Feld sichtbar.
  terminationRequestedById      String?
  terminationRequestedBy        User?                @relation("AssignmentTerminationRequestedBy", fields: [terminationRequestedById], references: [id])
  terminationRequestedAt        DateTime?
  /// Genehmigung der Kundenseite, **nur** bei Antrag der Kundenseite
  /// (4.3.1, Zuweisung der Genehmigung; [26]).
  ///
  /// **Über 3.7 hinaus.** Die Attributtabelle in 3.7 führt für diese
  /// Genehmigung kein Feld — 4.3.1 macht sie aber zur Vorbedingung des
  /// Übergangs nach `terminatedEarly`. Ohne ein Feld wäre die Vorbedingung
  /// nicht prüfbar. Die Lücke ist dieselbe, die 4.3.2 am Ende benennt, und
  /// steht als *offene Frage 39* in Kapitel 7.
  terminationApprovedAt         DateTime?
  terminationApprovedById       String?
  terminationApprovedBy         User?                @relation("AssignmentTerminationApprovedBy", fields: [terminationApprovedById], references: [id])
  status                        AssignmentStatus
  externalReference             String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("AssignmentUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("AssignmentDeactivatedBy", fields: [deactivatedById], references: [id])

  extensions    AssignmentExtension[]
  interruptions AssignmentInterruption[]

  @@index([tenantId])
  @@index([customerId])
  @@index([candidateId])
  @@index([workerIdentityId])
  @@index([supplierId])
  @@index([status])
}

/// Verlängerung (`assignmentExtension`, SPEC 3.7) — die Verschiebung des
/// Einsatzendes nach hinten, als eigener, protokollierter Vorgang.
///
/// **Keine stille Änderung** von `plannedEndDate`: jede Verlängerung ist ein
/// Satz mit Antrag, Genehmigung und Wirksamkeit (3.7, 4.3.2). Sie teilt die
/// Matrixzeile des Einsatzes (2.2, Lesart) und dessen Mandanten und trägt
/// deshalb keine eigene `tenantId`.
///
/// Statusmodell 4.3.2, umgesetzt in lib/status/assignmentExtension.ts.
model AssignmentExtension {
  id                String                    @id @default(cuid())
  assignmentId      String
  assignment        Assignment                @relation(fields: [assignmentId], references: [id])
  /// Muss nach dem bisherigen Ende liegen (3.7).
  newEndDate        DateTime
  reason            String
  requestedAt       DateTime
  requestedById     String
  requestedBy       User                      @relation("ExtensionRequestedBy", fields: [requestedById], references: [id])
  /// Pflicht ab Genehmigung: `KG`, soweit 4.3 sie der Kundenseite zuweist
  /// ([26]) — und das tut 4.3.2 für die Verlängerung **immer**.
  approvedAt        DateTime?
  approvedById      String?
  approvedBy        User?                     @relation("ExtensionApprovedBy", fields: [approvedById], references: [id])
  /// Pflicht ab Wirksamkeit: `MD` ([25]).
  effectiveAt       DateTime?
  effectiveById     String?
  effectiveBy       User?                     @relation("ExtensionEffectiveBy", fields: [effectiveById], references: [id])
  /// Begründung der Ablehnung (4.3.2, `requested` → `rejected`).
  rejectionReason   String?
  withdrawnAt       DateTime?
  /// *Abgeleitet* — Ergebnis der AÜG-Prüfung (5.1, 5.5). Gerechnet in
  /// Kapitel 5; dieses Feld hält nur das Ergebnis am Vorgang.
  ruleCheckResult   RuleCheckResult?
  status            AssignmentExtensionStatus
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("ExtensionCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("ExtensionUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("ExtensionDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([assignmentId])
  @@index([status])
}

/// Unterbrechung (`assignmentInterruption`, SPEC 3.7) — eine dokumentierte
/// Unterbrechung der Überlassung.
///
/// Fachlich notwendig, weil eine Unterbrechung von mehr als drei Monaten die
/// Zählung der Höchstüberlassungsdauer zurücksetzt (5.1.4). Erfasst werden
/// **dokumentierte** Unterbrechungen **innerhalb** eines laufenden Einsatzes;
/// die Lücke **zwischen** zwei Einsätzen braucht kein eigenes Objekt — sie
/// ergibt sich aus den Einsatzdaten (5.1.4).
///
/// Statusmodell: keines; relevant ist der Zeitraum. Der Einsatzstatus
/// `interrupted` steht in 4.3.1.
model AssignmentInterruption {
  id                String     @id @default(cuid())
  assignmentId      String
  assignment        Assignment @relation(fields: [assignmentId], references: [id])
  interruptionFrom  DateTime
  /// Leer = läuft noch (3.7).
  interruptionTo    DateTime?
  /// Katalogwert + Text (3.7). Der Katalog ist Konfiguration, deshalb ein
  /// Textfeld. **Hinweis zur Datenkategorie:** der Grund kann auf
  /// Abwesenheitsgründe und damit auf Gesundheitsdaten hinauslaufen — siehe
  /// *offene Frage 21*; im Prototyp werden nur neutrale Gründe geführt.
  reasonCategory    String
  reasonText        String?
  /// *Abgeleitet* — Ergebnis der Rechenvorschrift aus 5.1 (Prüfung P2).
  countsAsReset     Boolean?
  externalReference String?

  createdAt       DateTime  @default(now())
  createdById     String?
  createdBy       User?     @relation("InterruptionCreatedBy", fields: [createdById], references: [id])
  updatedAt       DateTime? @updatedAt
  updatedById     String?
  updatedBy       User?     @relation("InterruptionUpdatedBy", fields: [updatedById], references: [id])
  deactivatedAt   DateTime?
  deactivatedById String?
  deactivatedBy   User?     @relation("InterruptionDeactivatedBy", fields: [deactivatedById], references: [id])

  @@index([assignmentId])
}
