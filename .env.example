# Vorlage für .env — hier stehen NUR Platzhalter, niemals echte Werte.
# Die echte .env ist in .gitignore ausgeschlossen und wird nie committet.

# Datenbank
DATABASE_URL=

# Anwendung
APP_ENV=development
APP_SECRET=

# E-Mail / Benachrichtigungen (optional im Prototyp)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
