# Vorlage für .env — hier stehen NUR Platzhalter, niemals echte Werte.
# Die echte .env ist in .gitignore ausgeschlossen und wird nie committet.

# Datenbank
# PostgreSQL-Verbindung für Prisma, einzige Quelle der Verbindungsdaten.
# Form: postgresql://BENUTZER:PASSWORT@HOST:PORT/DATENBANK?schema=public
DATABASE_URL=

# Anwendung
APP_ENV=development
APP_SECRET=

# Testidentität des Prototyps (lib/identity/testIdentity.ts): Id des Benutzers,
# als der gehandelt wird, solange kein Cookie gesetzt ist. Keine Anmeldedaten —
# der Prototyp hat keine Authentifizierung (SPEC 3.0, Festlegung 4).
VMS_TEST_IDENTITY=

# E-Mail / Benachrichtigungen (optional im Prototyp)
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
