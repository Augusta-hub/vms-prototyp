# Vorlage für .env — hier stehen NUR Platzhalter, niemals echte Werte.
# Die echte .env ist in .gitignore ausgeschlossen und wird nie committet.

# Datenbank
# PostgreSQL-Verbindung für Prisma, einzige Quelle der Verbindungsdaten.
# Form: postgresql://BENUTZER:PASSWORT@HOST:PORT/DATENBANK?schema=public
DATABASE_URL=

# Anwendung
APP_ENV=development
APP_SECRET=

# Testidentität des Prototyps (lib/identity/testIdentity.ts): Id des Benutzers,
# als der gehandelt wird, solange kein Cookie gesetzt ist. Keine Anmeldedaten —
# der Prototyp hat keine Authentifizierung (SPEC 3.0, Festlegung 4).
VMS_TEST_IDENTITY=

# Nächtlicher Lauf (SPEC 5.5.1) und Postausgang (3.14): geteiltes Geheimnis für
# den Planer außerhalb des Systems. Er ruft POST /api/naechtlicher-lauf und
# POST /api/zustellung mit `Authorization: Bearer <WERT>` auf. Ist der Wert
# leer, sind beide Zugänge zu — Lauf und Zustellung lassen sich dann nur von
# Hand anstoßen.
NIGHTLY_RUN_TOKEN=

# Zustellung der Benachrichtigungen per E-Mail (SPEC 3.14, Frage 56).
#
# Ohne MAIL_FROM geht nichts hinaus; die Zustellaufträge bleiben offen. Sind
# Absender und ein Weg gesetzt, entscheidet MAIL_RELAY_URL vor MAIL_OUTBOX_DIR.
#
#  - MAIL_FROM        Absenderadresse.
#  - MAIL_RELAY_URL   Adresse eines Dienstes, der einen Brief als JSON annimmt
#                     ({from, to, subject, text}). Nur `https` — der Inhalt der
#                     Nachricht geht nicht unverschlüsselt (SPEC 6.8).
#  - MAIL_RELAY_TOKEN Bearer-Schlüssel dieses Dienstes, falls er einen braucht.
#  - MAIL_OUTBOX_DIR  Verzeichnis für den Dateiausgang der Entwicklung: jeder
#                     Brief wird als Datei geschrieben, nichts verlässt den
#                     Rechner. Kein Weg für den Betrieb.
MAIL_FROM=
MAIL_RELAY_URL=
MAIL_RELAY_TOKEN=
MAIL_OUTBOX_DIR=

# Basisadresse des Systems für den Hinweis am Ende des Briefes (SPEC 3.14).
# Leer = kein Hinweis; eine geratene Adresse wäre ein Link ins Nichts.
APP_BASE_URL=
